# TEMPLATE ONLY: this file is intentionally not listed by the KSOPS generator
# and must never be applied as-is. Copy it to cloudflare-secret.yaml locally,
# replace the placeholder with the dedicated Cloudflare API token, encrypt it
# with the repository's SOPS policy, and commit only the encrypted result.
#
# Intended scope (owner-provided): account-wide read-only access for the
# account containing xnoto.dev, makeitwork.cloud, and orthodox.channel. The
# hosted Cloudflare MCP requires Account Resources: Read for account-token
# discovery. Choose only required read permission groups; do not reuse an
# OpenTofu, tunnel, Access, or other workload credential.
#
# After adding the encrypted cloudflare-secret.yaml, add it to the files list
# in ksops-mcp-gateway-secrets.yaml before opening a pull request.
apiVersion: v1
kind: Secret
metadata:
  name: mcp-cloudflare-api-token
  namespace: mcp
  annotations:
    argocd.argoproj.io/sync-wave: "0"
type: Opaque
stringData:
  token: REPLACE_WITH_A_DEDICATED_READ_ONLY_CLOUDFLARE_API_TOKEN
