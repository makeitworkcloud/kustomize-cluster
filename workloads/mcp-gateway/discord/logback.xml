<?xml version="1.0" encoding="UTF-8"?>
<!-- Stderr-only console logging for the discord MCP backend. Logs go to the
     container stderr stream (kubectl / Argo CD logs). No file appender: the
     root filesystem is read-only and the workload keeps no log state. -->
<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>
  <root level="INFO">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
